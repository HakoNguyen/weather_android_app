<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C27"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- 1. Tên thành phố -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hà Nội"
            android:textColor="@android:color/white"
            android:textSize="24sp"

            android:drawablePadding="8dp" />

        <!-- 2. Nhiệt độ hiện tại -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25°"
            android:textColor="@android:color/white"
            android:textSize="96sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <!-- 3. Mô tả thời tiết và nhiệt độ cao/thấp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Có mây 22° / 28°"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <!-- 4. Dự báo hàng giờ (Sử dụng RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hourlyForecastRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            tools:listitem="@layout/hourly_forecast_item"
            tools:itemCount="6" />

        <!-- 5. Dự báo hàng ngày (Sử dụng RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dailyForecastRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            tools:listitem="@layout/daily_forecast_item"
            tools:itemCount="7" />

        <!-- Thêm các thông tin chi tiết khác (UV, Gió,...) bằng GridLayout hoặc LinearLayout ở đây -->

    </LinearLayout>
</ScrollView>
